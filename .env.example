APP_NAME="Ruang Dharma Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Untuk MySQL di server:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ruang_dharma_studio
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
SESSION_DOMAIN=null

# === Integrasi Muse ===
MUSE_API_TOKEN=change-me-strong-token-min-32-char
MUSE_WEBHOOK_SECRET=change-me-webhook-secret
MUSE_BASE_URL=https://muse.example.com
MUSE_TIMEOUT=15

# Default quota
DEFAULT_DAILY_LIMIT=5
