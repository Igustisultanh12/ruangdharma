APP_NAME="Ruang Dharma Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Untuk MySQL di server:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ruang_dharma_studio
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
# Laravel 11 uses CACHE_STORE (not CACHE_DRIVER). Keep CACHE_STORE=file for
# zero-config setup. If you set CACHE_STORE=database, you MUST run migrations
# so the `cache` and `cache_locks` tables exist (migration
# 2026_10_18_000012_create_cache_jobs_tables.php), otherwise you will get:
# "SQLSTATE[42S02]: Base table or view not found: 1146 Table '...cache' doesn't exist".
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

SESSION_DOMAIN=null

# === Integrasi Muse ===
# Kosongkan jika token dibuat lewat menu Admin > Integrasi Muse (disarankan).
# Nilai placeholder "change-me..." otomatis diabaikan demi keamanan.
MUSE_API_TOKEN=
MUSE_WEBHOOK_SECRET=
MUSE_BASE_URL=
MUSE_TIMEOUT=15

# Default quota
DEFAULT_DAILY_LIMIT=5
